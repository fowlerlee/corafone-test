# ═══════════════════════════════════════════════════════════
# Corafone Agent — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# LiveKit Cloud credentials (server-side only)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# LiveKit agent dispatch name — must match the agent_name in agent.py
NEXT_PUBLIC_LIVEKIT_AGENT_NAME=corafone-collector

# Neon Postgres connection string (used by agent.py only)
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
